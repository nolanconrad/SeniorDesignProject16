                "-NoExit",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { . 'C:/esp/v5.5.1/esp-idf/export.ps1' }"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "ESP-IDF PowerShell"
}